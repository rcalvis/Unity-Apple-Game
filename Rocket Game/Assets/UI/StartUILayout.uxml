    <ui:Label text="Apple Game" name="TitleLabel" style="align-self: center; align-content: center; font-size: 45px; -unity-font-style: bold; color: rgb(255, 255, 255); top: 20%; transition-property: font-size; transition-duration: 5s; transition-timing-function: ease; transition-delay: 0s; text-shadow: 25px 25px 3px rgba(0, 0, 0, 0.31);"/>
    <ui:Label text="Select Character&#10;" name="SelectCharacterLabel" style="height: 31px; width: 163px; color: rgb(255, 255, 255); -unity-text-align: middle-center; align-self: center; align-content: center; top: 18%; font-size: 20px;"/>
    <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; flex-direction: row; -unity-text-align: middle-center; justify-content: center; align-content: auto; height: auto; background-size: 100% 100%; max-height: 85px; min-height: 85px; top: 19%; align-items: center;">
        <ui:Button text="" name="PinkMan" data-source="project://database/Assets/USS/ButtonUSS.uss?fileID=7433441132597879392&amp;guid=0238c42d8e06147be872f697f9cc8f7a&amp;type=3#ButtonUSS" class="char-button" style="height: 70px; width: 70px; align-content: center; align-self: center; top: 0%; right: 0%; justify-content: flex-start; align-items: stretch; flex-direction: column; bottom: 0; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-width: 70px; min-height: 70px; max-width: 70px; max-height: 70px;">
            <ui:Image name="PinkManImage" class="char-image" style="width: 100%; height: 100%; align-items: center; align-content: center; justify-content: center; align-self: center; -unity-background-scale-mode: scale-to-fit;"/>
        </ui:Button>
        <ui:Button text="" name="NinjaFrog" class="char-button" style="height: 70px; width: 70px; align-content: flex-start; align-self: center; top: 0%; right: 0%; border-top-width: 0; border-right-width: 0; background-color: rgba(188, 188, 188, 0); border-bottom-width: 0; border-left-width: 0; min-width: 70px; min-height: 70px; max-width: 70px; max-height: 70px;">
            <ui:Image name="NinjaFrogImage" class="char-image" style="height: 100%; width: 100%;"/>
        </ui:Button>
        <ui:Button text="" name="VirtualGuy" class="char-button" style="height: 70px; width: 70px; align-content: center; align-self: center; top: 0%; right: 0%; justify-content: flex-start; align-items: stretch; flex-direction: column; bottom: 0; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-width: 70px; min-height: 70px; max-width: 70px; max-height: 70px;">
            <ui:Image name="VirtualGuyImage" class="char-image" style="width: 100%; height: 100%;"/>
        </ui:Button>
        <ui:Button text="" name="MaskDude" class="char-button" style="height: 70px; width: 70px; align-content: center; align-self: center; top: 0%; right: 0%; justify-content: flex-start; align-items: stretch; flex-direction: column; bottom: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); min-width: 70px; min-height: 70px; max-width: 70px; max-height: 70px;">
            <ui:Image name="MaskDudeImage" scale-mode="ScaleToFit" class="char-image" style="width: 100%; height: 100%;"/>
        </ui:Button>
    </ui:VisualElement>
    <ui:Button text="Start" name="StartButton" style="align-self: center; align-content: flex-start; top: 23%; height: 36px; width: 54px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-left-radius: 5px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=9f831e1779e314768848163978b9467a&amp;type=3#NotInter-Regular&quot;); border-top-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); background-color: rgb(157, 204, 152); color: rgb(255, 255, 255);"/>
